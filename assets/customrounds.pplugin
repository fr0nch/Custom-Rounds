    {
      "name": "OnForceRoundStartPreRegister",
      "funcName": "__OnForceRoundStartPreRegister",
      "description": "Регистрирует callback для события OnForceRoundStartPre.",
      "paramTypes": [
        {
          "type": "function",
          "name": "callback",
          "description": "Функция обратного вызова.",
          "prototype": {
            "name": "OnForceRoundStartPreCallback",
            "funcName": "_",
            "description": "Обрабатывает событие установки следующего раунда. Позволяет реагировать на событие, используя данные о его названии и клиенте.",
            "paramTypes": [
              {
                "type": "string",
                "name": "name",
                "description": "Указатель на строку с именем следующего раунда.",
                "ref": true
              },
              {
                "type": "int32",
                "name": "client",
                "description": "ID клиента, инициировавшего событие."
              }
            ],
            "retType": {
              "type": "int32",
              "description": "PluginResult Возможные результаты выполнения операции.",
              "enum": {
                "name": "PluginResult",
                "description": "PluginResult Возможные результаты выполнения операции.",
                "values": [
                  {
                    "name": "Continue",
                    "value": 0
                  },
                  {
                    "name": "Changed",
                    "value": 1
                  },
                  {
                    "name": "Handled",
                    "value": 2
                  },
                  {
                    "name": "Stop",
                    "value": 3
                  }
                ]
              }
            }
          }
        }
      ],
      "retType": {
        "type": "int32",
        "description": "Регистрирует callback для события OnForceRoundStartPre.",
        "enum": {
          "name": "ListenerID",
          "description": "Индекс зарегистрированного callback.",
          "values": []
        }
      }
    },
