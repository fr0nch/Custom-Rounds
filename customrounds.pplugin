      "description": "Sets the next round by name.",
      "paramTypes": [
        {
          "type": "string",
          "name": "name",
          "description": "Round name."
        },
        {
          "type": "int32",
          "name": "client",
          "description": "Player slot of the initiator."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round was set."
      },
      "group": "Rounds"
    },
    {
      "name": "SetNextRoundFromJson",
      "funcName": "__SetNextRoundFromJson",
      "description": "Sets the next round from JSON settings.",
      "paramTypes": [
        {
          "type": "string",
          "name": "presetRound",
          "description": "Round settings in JSON."
        },
        {
          "type": "int32",
          "name": "client",
