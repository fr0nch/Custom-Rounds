{
  "$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
  "name": "customrounds",
  "version": "2.0.0",
  "description": "Custom rounds for CS2: loads round presets from a JSON config and passes their settings to other plugins as KeyValues3.",
  "author": "Fr4nch",
  "website": "https://github.com/fr0nch",
  "license": "GPLv3",
  "dependencies": [
    {
      "name": "s2sdk",
      "constraints": ">=3.0.0"
    },
    {
      "name": "permissions",
      "optional": true
    }
  ],
  "entry": "bin/libcustomrounds",
  "language": "golang",
  "methods": [
    {
      "name": "CancelNextRound",
      "funcName": "__CancelNextRound",
      "description": "Cancels the next round.",
      "paramTypes": [
        {
          "type": "int32",
          "name": "client",
          "description": "Player slot of the initiator."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round was canceled."
      },
      "group": "Rounds"
    },
    {
      "name": "GetCurrentRound",
      "funcName": "__GetCurrentRound",
      "description": "Returns the current round.",
      "paramTypes": [],
      "retType": {
        "type": "ptr64",
        "description": "Round settings (KeyValues3), or 0 if the round is not custom. Valid until the round ends."
      },
      "group": "Rounds"
    },
    {
      "name": "GetCurrentRoundJsonString",
      "funcName": "__GetCurrentRoundJsonString",
      "description": "Returns the current round in JSON.",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "Round in JSON, or 'null' if the round is not custom."
      },
      "group": "Rounds"
    },
    {
      "name": "GetCurrentRoundName",
      "funcName": "__GetCurrentRoundName",
      "description": "Returns the current round name.",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "Round name, or empty string if the round is not custom."
      },
      "group": "Rounds"
    },
    {
      "name": "GetJsonString",
      "funcName": "__GetJsonString",
      "description": "Returns all rounds from the config in JSON.",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "Rounds in JSON."
      },
      "group": "Config"
    },
    {
      "name": "GetNextRound",
      "funcName": "__GetNextRound",
      "description": "Returns the next round.",
      "paramTypes": [],
      "retType": {
        "type": "ptr64",
        "description": "Round settings (KeyValues3), or 0 if not set. Valid until the round starts or is canceled."
      },
      "group": "Rounds"
    },
    {
      "name": "GetNextRoundKeyValueJsonString",
      "funcName": "__GetNextRoundKeyValueJsonString",
      "description": "Returns the next round in JSON.",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "Round in JSON, or 'null' if not set."
      },
      "group": "Rounds"
    },
    {
      "name": "GetNextRoundName",
      "funcName": "__GetNextRoundName",
      "description": "Returns the next round name.",
      "paramTypes": [],
      "retType": {
        "type": "string",
        "description": "Round name, or empty string if not set."
      },
      "group": "Rounds"
    },
    {
      "name": "GetRound",
      "funcName": "__GetRound",
      "description": "Returns a round from the config by name.",
      "paramTypes": [
        {
          "type": "string",
          "name": "name",
          "description": "Round name."
        }
      ],
      "retType": {
        "type": "ptr64",
        "description": "Round settings (KeyValues3), or 0 if not found. Valid until the config is reloaded."
      },
      "group": "Config"
    },
    {
      "name": "GetRoundIndex",
      "funcName": "__GetRoundIndex",
      "description": "Returns the index of a round in the config.",
      "paramTypes": [
        {
          "type": "string",
          "name": "name",
          "description": "Round name."
        }
      ],
      "retType": {
        "type": "int32",
        "description": "Round index, or -1 if not found."
      },
      "group": "Config"
    },
    {
      "name": "GetRoundNames",
      "funcName": "__GetRoundNames",
      "description": "Returns the names of all rounds from the config.",
      "paramTypes": [],
      "retType": {
        "type": "string[]",
        "description": "Round names."
      },
      "group": "Config"
    },
    {
      "name": "GetRounds",
      "funcName": "__GetRounds",
      "description": "Returns all rounds from the config.",
      "paramTypes": [],
      "retType": {
        "type": "ptr64[]",
        "description": "Round settings (KeyValues3). Valid until the config is reloaded."
      },
      "group": "Config"
    },
    {
      "name": "IsCustomRound",
      "funcName": "__IsCustomRound",
      "description": "Checks if the current round is custom.",
      "paramTypes": [],
      "retType": {
        "type": "bool",
        "description": "True if the current round is custom."
      },
      "group": "Rounds"
    },
    {
      "name": "IsNextRoundCustom",
      "funcName": "__IsNextRoundCustom",
      "description": "Checks if the next round is custom.",
      "paramTypes": [],
      "retType": {
        "type": "bool",
        "description": "True if the next round is set."
      },
      "group": "Rounds"
    },
    {
      "name": "IsRoundEnd",
      "funcName": "__IsRoundEnd",
      "description": "Checks if the round has ended (between round_end and round_start).",
      "paramTypes": [],
      "retType": {
        "type": "bool",
        "description": "True if the round has ended."
      },
      "group": "Rounds"
    },
    {
      "name": "IsRoundExists",
      "funcName": "__IsRoundExists",
      "description": "Checks if a round exists in the config.",
      "paramTypes": [
        {
          "type": "string",
          "name": "name",
          "description": "Round name."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round exists."
      },
      "group": "Config"
    },
    {
      "name": "OnCancelCurrentRoundPost_Register",
      "funcName": "__OnCancelCurrentRoundPost_Register",
      "description": "Registers a OnCancelCurrentRoundPost callback.",
      "paramTypes": [
        {
          "type": "function",
          "name": "callback",
          "description": "Callback function.",
          "prototype": "OnCancelCurrentRoundPostCallback"
        }
      ],
      "retType": {
        "type": "int32",
        "description": "Listener ID.",
        "alias": {
          "name": "ListenerID",
          "description": "Listener ID."
        }
      },
      "group": "Listeners"
    },
    {
