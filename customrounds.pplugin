      },
      "group": "Rounds"
    },
    {
      "name": "SetNextRoundFromKeyValue",
      "funcName": "__SetNextRoundFromKeyValue",
      "description": "Sets the next round from KeyValues3 settings. The settings are copied.",
      "paramTypes": [
        {
          "type": "ptr64",
          "name": "round",
          "description": "Round settings (KeyValues3)."
        },
        {
          "type": "int32",
          "name": "client",
          "description": "Player slot of the initiator."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round was set."
      },
      "group": "Rounds"
    },
    {
      "name": "StartRound",
      "funcName": "__StartRound",
      "description": "Ends the current round and starts a round by name. The next round is kept.",
      "paramTypes": [
        {
          "type": "string",
          "name": "name",
          "description": "Round name."
        },
        {
          "type": "int32",
          "name": "client",
          "description": "Player slot of the initiator."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round was started."
      },
      "group": "Rounds"
    },
    {
      "name": "StartRoundFromKeyValue",
      "funcName": "__StartRoundFromKeyValue",
      "description": "Ends the current round and starts a round from KeyValues3 settings. The settings are copied.",
      "paramTypes": [
        {
          "type": "ptr64",
          "name": "round",
          "description": "Round settings (KeyValues3)."
        },
        {
          "type": "int32",
          "name": "client",
          "description": "Player slot of the initiator."
        }
      ],
      "retType": {
        "type": "bool",
        "description": "True if the round was started."
      },
      "group": "Rounds"
    },
    {
